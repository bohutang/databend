# Exercise a failing pipeline followed by a successful query in the same session.
statement ok
set max_threads = 4

statement error (?s).*x.*
select sum(to_uint64(concat(to_string(number), 'x'))) from numbers_mt(10000)

query I
select sum(number) from numbers_mt(10000)
----
49995000

statement ok
unset max_threads
